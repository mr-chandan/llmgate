# Which environment we're running in. Affects logging, error detail, etc.
NODE_ENV=development

# Where the gateway listens.
PORT=4000
HOST=127.0.0.1

# Log verbosity. Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Path to SQLite file (production: switch to a Postgres URL once we add that adapter)
DATABASE_URL=./dev.sqlite

